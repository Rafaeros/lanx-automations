/* ================================
   TEMA MODERNO • DARK 2025
   Cor primária: Roxo Moderno (#9B5BFF)
================================ */

/* -------- BASE GLOBAL -------- */
QWidget {
    background-color: #1A1A1A;
    color: #E6E6E6;
    font-family: "Segoe UI", "Roboto";
    font-size: 14px;
}

/* Links, textos destacados */
a, QLabel#link {
    color: #9B5BFF;
}

/* ------------------------------
        BARRA DE ROLAGEM
------------------------------ */
QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #3A3A3A;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #9B5BFF;
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    height: 0px;
}

/* ------------------------------
             BOTÕES
------------------------------ */
QPushButton {
    background-color: #2A2A2A;
    color: #F0F0F0;
    border: 1px solid #3A3A3A;
    padding: 6px 14px;
    border-radius: 8px;
}
QPushButton:hover {
    background-color: #3A3A3A;
}
QPushButton:pressed {
    background-color: #9B5BFF;
}
QPushButton#primary {
    background-color: #9B5BFF;
    color: #ffffff;
}
QPushButton#primary:hover {
    background-color: #B07DFF;
}

/* ------------------------------
              INPUTS
------------------------------ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    padding: 6px;
    border-radius: 6px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #9B5BFF;
    background-color: #262626;
}

/* ------------------------------
            TABS
------------------------------ */
QTabWidget::pane {
    border: 1px solid #3A3A3A;
    border-radius: 6px;
}

QTabBar::tab {
    background: #2A2A2A;
    padding: 8px 16px;
    border-radius: 6px;
    margin: 2px;
}

QTabBar::tab:selected {
    background: #9B5BFF;
    color: white;
}

/* ------------------------------
            LIST
------------------------------ */

QListWidget {
    background-color: #1F1F1F;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    color: #E6E6E6;
}

/* Itens normais */
QListWidget::item {
    background-color: transparent;
    padding: 10px;
    margin: 2px;
    border-radius: 6px;
    color: #DDDDDD;
}

/* Hover */
QListWidget::item:hover {
    background-color: #2A2A2A;
    color: #FFFFFF;
}

/* Item selecionado */
QListWidget::item:selected {
    background-color: #9B5BFF;
    color: #FFFFFF;
    border: none;
}

/* Remover borda feia de foco */
QListWidget::item:selected:!active {
    background-color: #8448E6;
}

/* Focus da lista */
QListWidget:focus {
    border: 1px solid #9B5BFF;
}

/* Scrollbars internas seguem o tema geral */
QListWidget QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 10px;
    margin: 0px;
}

QListWidget QScrollBar::handle:vertical {
    background: #3A3A3A;
    border-radius: 5px;
}

QListWidget QScrollBar::handle:vertical:hover {
    background: #9B5BFF;
}

QListWidget QScrollBar::add-line,
QListWidget QScrollBar::sub-line {
    background: none;
    height: 0px;
}