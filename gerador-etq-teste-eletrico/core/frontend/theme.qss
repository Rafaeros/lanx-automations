/* ================================
   TEMA PREMIUM • MODERN UI 2025
   Fundo App: #f8fafc (Slate 50)
   Destaque: #7c3aed (Violet 600)
   Bordas: #e2e8f0 (Slate 200)
================================ */

/* -------- BASE GLOBAL -------- */
QWidget {
    background-color: #f8fafc;
    color: #1e293b;
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

QLabel {
    color: #475569;
    font-weight: 500;
}

/* ------------------------------
        BARRA DE ROLAGEM
------------------------------ */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #7c3aed;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    height: 0px;
}

/* ------------------------------
             BOTÕES
------------------------------ */
QPushButton {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

/* Botão Primário (Gradiente Moderno) */
QPushButton#primary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7c3aed, stop:1 #2563eb);
    color: #ffffff;
    border: none;
    padding: 12px 24px;
    font-size: 15px;
}

QPushButton#primary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8b5cf6, stop:1 #3b82f6);
}

QPushButton#primary:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6d28d9, stop:1 #1d4ed8);
}

/* Botão de Perigo/Erro */
QPushButton#danger {
    background-color: #fee2e2;
    color: #ef4444;
    border: 1px solid #fecaca;
}

QPushButton#danger:hover {
    background-color: #ef4444;
    color: #ffffff;
    border: 1px solid #dc2626;
}

QPushButton#danger:pressed {
    background-color: #b91c1c;
    color: #ffffff;
}

/* ------------------------------
           CHECKBOX
------------------------------ */
QCheckBox {
    spacing: 8px;
    color: #475569;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #7c3aed;
}

QCheckBox::indicator:checked {
    background-color: #7c3aed;
    border: 1px solid #7c3aed;
}

/* ------------------------------
              INPUTS
------------------------------ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    padding: 10px;
    border-radius: 8px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 2px solid #7c3aed;
    background-color: #ffffff;
}

/* ------------------------------
             TABS
------------------------------ */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 12px 24px;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #7c3aed;
    border-bottom: 2px solid #7c3aed;
}

QTabBar::tab:hover:!selected {
    color: #1e293b;
    background: #f1f5f9;
    border-radius: 8px;
}

/* ------------------------------
             LISTS
------------------------------ */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 8px;
    outline: 0;
}

QListWidget::item {
    padding: 14px;
    margin: 2px 0px;
    border-radius: 8px;
    color: #334155;
}

QListWidget::item:hover {
    background-color: #f1f5f9;
    color: #7c3aed;
}

QListWidget::item:selected {
    background-color: #eef2ff;
    color: #7c3aed;
    font-weight: 600;
}