/* ================================
   TEMA MODERNO • DARK 2025
   Cor primária: Roxo Moderno (#9B5BFF)
================================ */

/* -------- BASE GLOBAL -------- */
QWidget {
    background-color: #1A1A1A;
    color: #E6E6E6;
    font-family: "Segoe UI", "Inter", "Roboto";
    font-size: 14px;
}

/* Links, textos destacados */
a, QLabel#link {
    color: #9B5BFF;
}

/* ------------------------------
        BARRA DE ROLAGEM
------------------------------ */
QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #3A3A3A;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #9B5BFF;
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    height: 0px;
}

/* ------------------------------
             BOTÕES
------------------------------ */
QPushButton {
    background-color: #2A2A2A;
    color: #F0F0F0;
    border: 1px solid #3A3A3A;
    padding: 6px 14px;
    border-radius: 8px;
}
QPushButton:hover {
    background-color: #3A3A3A;
}
QPushButton:pressed {
    background-color: #9B5BFF;
}
QPushButton#primary {
    background-color: #9B5BFF;
    color: #ffffff;
}
QPushButton#primary:hover {
    background-color: #B07DFF;
}

/* ------------------------------
              INPUTS
------------------------------ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    padding: 6px;
    border-radius: 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #9B5BFF;
    box-shadow: 0 0 8px #9B5BFF;
}


/* ------------------------------
            TABS
------------------------------ */
QTabWidget::pane {
    border: 1px solid #3A3A3A;
    border-radius: 6px;
}
QTabBar::tab {
    background: #2A2A2A;
    padding: 8px 16px;
    border-radius: 6px;
    margin: 2px;
}
QTabBar::tab:selected {
    background: #9B5BFF;
    color: white;
}